# Webapp settings for local development without Azure (BEACONS_LOCAL_AUTH=true in the root .envrc).
#
# Save as .env.local-auth (gitignored). `make serve` loads this file instead of .env.local, so nothing here needs to
# come from 1Password, and nothing from .env.local is read in this mode.
#
# The local user's email, password and roles are set in the root .envrc.local-auth, not here.

API_URL=http://localhost:8080/spring-api
NEXTAUTH_URL=http://localhost:3000
REDIS_URI=redis://localhost:6379
REDIS_DRAFT_REGISTRATION_TTL=86400

# Signs the local session cookie. Any value will do locally.
JWT_SECRET=local-development-only
AUTH_SECRET=local-development-only

# Optional: without an API key, the webapp logs that it is not sending GOV.UK Notify emails.
# GOV_NOTIFY_API_KEY=
# GOV_NOTIFY_FEEDBACK_EMAIL_ADDRESS=
